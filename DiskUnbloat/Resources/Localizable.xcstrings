    "Docker Desktop's updater parks the new app bundle here while swapping it into /Applications. After a successful update it should be empty; content left behind points at a partially finished update, not at space to reclaim." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker Desktop's updater parks the new app bundle here while swapping it into /Applications. After a successful update it should be empty; content left behind points at a partially finished update, not at space to reclaim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновлятель Docker Desktop временно кладёт сюда новый бандл приложения перед подменой в /Applications. После успешного обновления папка должна быть пустой; остатки говорят о незавершённом обновлении, а не о свободном месте."
          }
        }
      }
    },
    "Docker images, containers, and volumes. Removal deletes Docker data." : {
      "extractionState" : "stale",
      "localizations" : {
