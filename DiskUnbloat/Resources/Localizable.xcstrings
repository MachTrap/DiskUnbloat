        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти расположения прочитаны не полностью. Их полные размеры неизвестны; известные байты учтены на карте. Показано до 500 проблем."
          }
        }
      }
    },
    "These tools clean their own caches. Running the tool is safer than deleting its files." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These tools clean their own caches. Running the tool is safer than deleting its files."
